# Copy to .env and fill in. Never commit .env.

# Where search.yaml and sources.yaml live
JOB_HUNTER_CONFIG_DIR=config
LOG_LEVEL=INFO

# --- Email alerts (IMAP). For Gmail: enable 2FA, then create an App Password.
# Use a dedicated inbox that only receives job alerts.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Adzuna API (self-serve signup on Adzuna's developer site)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- France Travail API (francetravail.io; new access requests currently on hold)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
